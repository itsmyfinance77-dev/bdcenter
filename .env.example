# PostgreSQL connection string (use 127.0.0.1 on Windows, not localhost — it may resolve to IPv6 first).
# The default matches the dev container in docker-compose.yml (`docker compose up -d`).
DATABASE_URL="postgresql://bdcenter:bdcenter@127.0.0.1:5434/bdcenter_dev?schema=public"

# Session cookie signing secret for the admin panel (generate with: openssl rand -base64 48)
SESSION_SECRET=""

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="https://bdcenter.yazdccima.com"

# Directory for private uploads (form attachments). Defaults to ./storage; keep it outside public/.
STORAGE_DIR="storage"

# Header your reverse proxy overwrites with the visitor's address, used for rate limiting
# (e.g. "x-real-ip" with nginx `proxy_set_header X-Real-IP $remote_addr;`). Leave empty to use
# the last X-Forwarded-For entry. Without a proxy in front, visitors can fake either header.
CLIENT_IP_HEADER=""

# AES-256 key (32 bytes, base64) encrypting admins' two-step login secrets in the database.
# Generate with: openssl rand -base64 32. Changing it disables every admin's two-step login.
DATA_ENCRYPTION_KEY=""

# HMAC key for member sign-in codes (generate with: openssl rand -base64 48). Only code hashes are stored.
OTP_SECRET=""

# SMS provider (OQ-BD-11): "console" (development only: prints messages to the server log),
# "sandbox" (development and the plain-HTTP preview only: nothing is sent, messages are listed in
# the admin panel under «صندوق پیامک آزمایشی»; test accounts: npm run sandbox:users),
# "kavenegar" or "smsir". Each provider stays off until all of its required settings are set.
SMS_PROVIDER="console"

# Kavenegar (kavenegar.com). Required: API key. Optional: sender line; OTP template name made in
# the Kavenegar panel with a %token% placeholder (without it, codes go out as plain text, which
# numbers that blocked advertising SMS may not receive).
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
KAVENEGAR_OTP_TEMPLATE=""
# Leave empty. Only for tests (a local fake API) or an outbound proxy.
KAVENEGAR_API_URL=""

# SMS.ir (sms.ir, API v1). Required: API key and line number. Optional: verify template id and the
# name of its code parameter (default CODE).
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER=""
SMSIR_OTP_TEMPLATE_ID=""
SMSIR_OTP_PARAM="CODE"

# Outgoing email for status notifications, e.g. "smtps://user:password@mail.example.com:465".
# Empty: development prints emails to the log, production sends none. MAIL_FROM is required with it.
SMTP_URL=""
MAIL_FROM=""

# Who gets an email when a new server error happens (comma-separated; needs SMTP_URL in production).
# Errors are always listed in the admin panel under "وضعیت سامانه" (/admin/system).
ERROR_ALERT_EMAIL=""

# Secret the scheduler sends (Authorization: Bearer ...) when it calls /api/cron/reminders every
# 15 minutes to send due reminder SMS. At least 32 characters (openssl rand -hex 32); empty = the
# reminders job is off. In development: npm run reminders:run (add -- --every 15 to keep it running).
CRON_SECRET=""

# Folder holding the backups written by deploy/backup/backup.sh, mounted read-only; the admin panel
# shows whether they are recent. Set by docker-compose.prod.yml; leave empty in development.
BACKUP_DIR=""
