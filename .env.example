# PostgreSQL connection string (use 127.0.0.1 on Windows, not localhost — it may resolve to IPv6 first).
# The default matches the dev container in docker-compose.yml (`docker compose up -d`).
DATABASE_URL="postgresql://bdcenter:bdcenter@127.0.0.1:5434/bdcenter_dev?schema=public"

# Session cookie signing secret for the admin panel (generate with: openssl rand -base64 48)
SESSION_SECRET=""

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="https://bdcenter.yazdccima.com"

# Directory for private uploads (form attachments). Defaults to ./storage; keep it outside public/.
STORAGE_DIR="storage"

# Header your reverse proxy overwrites with the visitor's address, used for rate limiting
# (e.g. "x-real-ip" with nginx `proxy_set_header X-Real-IP $remote_addr;`). Leave empty to use
# the last X-Forwarded-For entry. Without a proxy in front, visitors can fake either header.
CLIENT_IP_HEADER=""

# HMAC key for member sign-in codes (generate with: openssl rand -base64 48). Only code hashes are stored.
OTP_SECRET=""

# SMS provider for member sign-in codes (OQ-BD-11). "console" prints codes to the server log and
# only works outside production; a real provider must be added in src/modules/members/sms.ts.
SMS_PROVIDER="console"
