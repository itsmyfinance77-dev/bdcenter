# Production settings. Copy to `.env.production` in the project folder on the
# server (git-ignored), fill in every value, and keep it readable only by the
# admin (chmod 600). Used by docker-compose.prod.yml; see docs/operations/deploy.md.
# Never commit the filled-in file.

# --- Stack ------------------------------------------------------------------
# Domain served over HTTPS (DNS A record must point at this server first; OQ-BD-08).
SITE_DOMAIN="ccinno.center"
# Contact address for the certificate authority (expiry notices).
TLS_EMAIL=""
# Database password. Letters and digits only (it goes into a URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=""
# Password of bdcenter_app, the role the site itself connects as (it can only
# read and write rows). Letters and digits only, different from the above:
#   openssl rand -hex 24
APP_DB_PASSWORD=""
# Daily backup time in UTC, HH:MM (00:30 UTC = 04:00 Tehran), and how many to keep.
BACKUP_AT="00:30"
BACKUP_KEEP="14"

# --- App --------------------------------------------------------------------
# Same meaning as in .env.example. DATABASE_URL, STORAGE_DIR, BACKUP_DIR and
# CLIENT_IP_HEADER are set by docker-compose.prod.yml; do not set them here.
NEXT_PUBLIC_SITE_URL="https://ccinno.center"
# openssl rand -base64 48
SESSION_SECRET=""
# openssl rand -base64 32 (changing it later disables every admin's two-step login)
DATA_ENCRYPTION_KEY=""
# openssl rand -base64 48
OTP_SECRET=""
# Scheduler -> /api/cron/reminders (reminder SMS every 15 minutes): openssl rand -hex 32
CRON_SECRET=""

# SMS (OQ-BD-11): "kavenegar" or "smsir", plus that provider's keys (see .env.example).
SMS_PROVIDER=""
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
KAVENEGAR_OTP_TEMPLATE=""
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER=""
SMSIR_OTP_TEMPLATE_ID=""
SMSIR_OTP_PARAM="CODE"

# Outgoing email (status notifications and error alerts).
SMTP_URL=""
MAIL_FROM=""
# "1" accepts a self-signed/untrusted TLS cert on the SMTP server (some budget
# shared hosts never installed a real one) — only set this for a provider you
# already trust, see src/modules/messaging/email.ts.
SMTP_ALLOW_SELF_SIGNED=""
# Who gets an email when a new server error happens (comma-separated). Empty: no alerts.
ERROR_ALERT_EMAIL=""
