# HTTPS front for the site. Caddy obtains and renews the certificate itself
# (Let's Encrypt / ZeroSSL) once SITE_DOMAIN points at this server and ports
# 80 and 443 are open. See docs/operations/deploy.md.
{
	email {$TLS_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploads are capped at 10 MB by the app; leave room for the other fields.
	request_body {
		max_size 12MB
	}

	# Scheduled jobs are called by the scheduler container over the internal
	# network only; they are not reachable from the internet.
	@cron path /api/cron /api/cron/*
	respond @cron 404

	reverse_proxy app:3000 {
		# The app reads the visitor address from this header (CLIENT_IP_HEADER),
		# which Caddy always overwrites, so visitors cannot fake it.
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}

# Visitors typing www. land on the main name.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
