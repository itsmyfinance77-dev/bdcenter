{
  "name": "bdcenter-site",
  "version": "0.0.0",
  "private": true,
  "description": "Business Development Center (bdcenter.yazdccima.com) — a website for the business development center affiliated with the Yazd Chamber of Commerce.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3010",
    "build": "next build",
    "start": "next start",
    "preview:build": "node scripts/preview.mjs build",
    "preview": "node scripts/preview.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/db/**\"",
    "test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/db --no-file-parallelism",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "admin:create": "tsx scripts/create-admin.ts",
    "sandbox:users": "tsx --env-file=.env scripts/sandbox-users.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "argon2": "^0.41.1",
    "marked": "^18.0.14",
    "next": "^15.1.6",
    "nodemailer": "^10.0.12",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "prettier": "^3.4.2",
    "prisma": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2"
  }
}
