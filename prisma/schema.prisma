// Business Development Center (bdcenter.yazdccima.com) — initial data model.
// Rules: a domain owns its own models; other domains read through a service
// function, never through a direct Prisma relation across domain lines,
// unless the relation is intrinsic to the record (e.g. AuditLog.actorId).

// Default output (node_modules/.prisma/client, imported as @prisma/client):
// Next.js treats it as an external package and does not crawl it while tracing.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access (admin/editor side only — public visitors do not need an
// account for the request-based services in this phase)
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  /// Bumped on logout / password change; tokens carrying an older value are refused.
  sessionVersion Int     @default(0)
  /// Set when someone else chose the password (new account or reset by an ADMIN);
  /// the panel asks the user to pick their own. Cleared by changing it.
  mustChangePassword Boolean @default(false)
  /// Two-step login (TOTP). Secrets are AES-GCM encrypted with DATA_ENCRYPTION_KEY.
  totpSecret        String?
  /// Generated during setup, promoted to totpSecret once a code confirms it.
  totpPendingSecret String?
  totpEnabledAt     DateTime?
  /// Last accepted time step: a code cannot be replayed.
  totpLastStep      Int?
  /// SHA-256 hashes of unused one-time recovery codes.
  recoveryCodeHashes String[] @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

/// «رمز را فراموش کرده‌ام» links sent by email (owner's request, 2026-10-03).
/// Only a SHA-256 of the token is stored; a link works once, for 30 minutes.
model AdminPasswordReset {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@map("admin_password_resets")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     AdminUser? @relation(fields: [actorId], references: [id])
  action    String // e.g. "content.publish", "form.submission.export"
  entity    String // e.g. "Article", "FormDefinition"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Members: public visitors who sign up with a phone number (ADR-0002)
// ---------------------------------------------------------------------------

/// Who a member signs up as (owner's request, 2026-10-03).
enum PersonType {
  INDIVIDUAL // شخص حقیقی
  LEGAL // نمایندهٔ شخص حقوقی
}

/// Representatives of a legal entity wait for an ADMIN's review; individuals don't.
enum MemberApproval {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Member {
  id             String    @id @default(cuid())
  phone          String    @unique // normalized 09xxxxxxxxx
  fullName       String?
  /// The person's own کد ملی (10 digits), for individuals and representatives alike.
  nationalId     String?
  postalCode     String?
  personType     PersonType?
  /// LEGAL only: the company's name and شناسه ملی (11 digits). Not unique:
  /// several people may sign up for the same company.
  companyName    String?
  legalNationalId String?
  /// LEGAL only: introduction letter on the company's letterhead (private
  /// upload, `StoredFile` JSON, see src/modules/files).
  letterFile     Json?
  /// Image of the national card (private upload, `StoredFile` JSON). Optional
  /// unless an ADMIN makes it required (setting `members.nationalCardRequired`).
  nationalCardFile Json?
  approval       MemberApproval @default(NOT_REQUIRED)
  /// Reason shown to the member when an ADMIN rejects the legal-entity details.
  approvalNote   String?
  reviewedAt     DateTime?
  reviewedById   String?
  email          String?
  isActive       Boolean   @default(true)
  sessionVersion Int       @default(0)
  /// Part of the secret address of the member's personal calendar feed;
  /// bumping it makes the old address stop working.
  calendarVersion Int      @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([approval])
  @@index([legalNationalId])
  @@map("members")
}

/// Small admin-editable switches, one JSON value per key (src/modules/settings).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// One pending SMS code per phone; only its HMAC is stored.
model OtpChallenge {
  phone     String   @id
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_challenges")
}

// ---------------------------------------------------------------------------
// CMS: institutional pages, news/events, services
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Static institutional pages: "درباره مرکز", "تماس با ما", ...
model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  /// Typed sections: `markdown` (older pages) or `html` from the rich editor,
  /// sanitized on save and on render (ADR-0005), with its plain `text`.
  sections    Json
  status      ContentStatus @default(DRAFT)
  seoTitle    String?
  seoDesc     String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  revisions PageRevision[]

  @@map("pages")
}

/// The previous content of a page, saved before each change (owner's request,
/// 2026-10-03), so a mistake can be undone. The newest 30 per page are kept.
model PageRevision {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title       String
  sections    Json
  seoDesc     String?
  /// Who saved the change that replaced this version (admin id, audit domain).
  replacedById String?
  createdAt   DateTime @default(now())

  @@index([pageId, createdAt])
  @@map("page_revisions")
}

enum ArticleKind {
  NEWS
  EVENT
}

/// "اخبار و رویدادهای مرکز"
model Article {
  id          String        @id @default(cuid())
  kind        ArticleKind
  slug        String        @unique
  title       String
  excerpt     String?
  /// Plain text of the body (search, excerpts). Older articles hold Markdown
  /// here and render it while `bodyHtml` is empty.
  bodyMarkdown String
  /// Body from the rich editor, sanitized (ADR-0005).
  bodyHtml    String?
  coverImageId String?
  coverImage  MediaAsset?   @relation(fields: [coverImageId], references: [id])
  eventStartsAt DateTime?
  eventEndsAt   DateTime?
  eventLocation String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([kind, status, publishedAt])
  @@map("articles")
}

model MediaAsset {
  id           String   @id @default(cuid())
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  altText      String?
  /// "cover" (article covers, public once the article is published) or
  /// "page" (images placed in rich page bodies, public once uploaded).
  purpose      String   @default("cover")
  createdAt    DateTime @default(now())

  articles Article[]

  @@map("media_assets")
}

/// The 7 "خدمات مرکز" tiles: their slugs, icons and links are fixed in
/// src/content/site.ts; a row here holds what staff edited (src/modules/services).
/// Most start with `isPlaceholder = true`
/// ("اطلاعات این صفحه بعدا اضافه می‌شود") and get real content later —
/// the tile still renders, just without a detail page.
model Service {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String?
  externalUrl   String? // e.g. link to yazdccima.com/services/edu for training
  isPlaceholder Boolean  @default(false)
  /// Content of /services/<slug> from the rich editor (ADR-0005), and its text.
  bodyHtml      String?
  bodyText      String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

/// The "دسترسی به خدمات اتاق بازرگانی یزد" footer/section links — plain
/// outbound links to the parent chamber site, not owned content.
model ExternalLink {
  id        String   @id @default(cuid())
  section   String // e.g. "chamber-services", "useful-links"
  title     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("external_links")
}

// ---------------------------------------------------------------------------
// Membership — OQ-BD-01: pricing tiers are NOT enforced yet (see
// docs/product/open-questions.md). This table only stores the imported
// roster; access/pricing logic stays behind a single lookup function
// (`getMembershipTier`) so the real rule can land later without touching
// every call site.
// ---------------------------------------------------------------------------

enum MembershipTier {
  NORMAL // عادی — non-member, non-tech company
  SPECIAL // ویژه — tech/knowledge-based company, non-member
  PREMIUM // ممتاز — Chamber member
}

model MembershipRecord {
  id           String         @id @default(cuid())
  nationalId   String         @unique // شناسه ملی یا کد ملی
  companyName  String?
  tier         MembershipTier
  sourceFile   String? // which Excel import this row came from, for traceability
  importedAt   DateTime       @default(now())

  @@map("membership_records")
}

// ---------------------------------------------------------------------------
// Training & consulting — the only two transactional services in this phase
// ---------------------------------------------------------------------------

enum RequestStatus {
  NEW
  IN_REVIEW
  ACCEPTED
  REJECTED
  DONE
}

model Course {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  /// Plain text (or older Markdown) of the description; see descriptionHtml.
  description String?
  /// Description from the rich editor, sanitized (ADR-0005).
  descriptionHtml String?
  /// Cover image (`course-covers/<uuid>.webp` + `-sm`, see storeImage); public
  /// only while the course is published. A new upload gets a new key.
  coverKey    String?
  coverAlt    String?
  instructor  String?
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  capacity    Int?
  /// Admins close enrollment without unpublishing the course.
  enrollmentOpen Boolean @default(true)
  /// Completion certificates (OQ-BD-16): off until the center decides per course.
  certificateEnabled        Boolean @default(false)
  certificateSignatory      String?
  certificateSignatoryTitle String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id             String        @id @default(cuid())
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The enrolling member (members domain) — a plain id, not a cross-domain relation.
  memberId       String
  fullName       String
  nationalId     String?
  phone          String
  email          String?
  companyName    String?
  status         RequestStatus @default(NEW)
  // Resolved at submission time from MembershipRecord, but never auto-billed
  // until OQ-BD-01 is answered — see docs/product/open-questions.md.
  membershipTier MembershipTier?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  certificate Certificate?

  @@unique([courseId, memberId])
  @@index([memberId])
  @@map("enrollments")
}

/// A course-completion certificate. Name, course and signatory are copied at
/// issue time, so later edits do not change a certificate already handed out.
model Certificate {
  id             String     @id @default(cuid())
  /// Printed on the certificate and checked at /certificates/<code>.
  code           String     @unique
  enrollmentId   String     @unique
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  fullName       String
  courseTitle    String
  courseStartsAt DateTime?
  courseEndsAt   DateTime?
  signatory      String?
  signatoryTitle String?
  issuedAt       DateTime   @default(now())
  /// Set when the enrollment stops being DONE; cleared if it becomes DONE again.
  revokedAt      DateTime?

  @@map("certificates")
}

/// "مرکز مشاوره (ویژه شرکت‌های فناور و دانش‌بنیان)" — request intake only.
model ConsultingRequest {
  id             String        @id @default(cuid())
  /// Set when a signed-in member sent it (members domain; a plain id, not a relation).
  memberId       String?
  fullName       String
  nationalId     String?
  phone          String
  email          String?
  companyName    String?
  topic          String
  description    String?
  membershipTier MembershipTier?
  status         RequestStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([memberId])
  @@map("consulting_requests")
}

// ---------------------------------------------------------------------------
// Dynamic form builder ("۸- فرم ساز" / "میز خدمت")
// ---------------------------------------------------------------------------

enum FormFieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  DATE
  SELECT
  FILE
  CHECKBOX
}

model FormDefinition {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  fields      FormField[]
  submissions FormSubmission[]

  @@map("form_definitions")
}

model FormField {
  id           String        @id @default(cuid())
  formId       String
  form         FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  key          String // stable machine name used as the JSON key in submissions
  label        String
  type         FormFieldType
  isRequired   Boolean       @default(false)
  options      Json? // for SELECT: string[]
  sortOrder    Int           @default(0)

  @@unique([formId, key])
  @@map("form_fields")
}

model FormSubmission {
  id        String         @id @default(cuid())
  formId    String
  form      FormDefinition @relation(fields: [formId], references: [id])
  data      Json // { [fieldKey]: value }
  status    RequestStatus  @default(NEW)
  createdAt DateTime       @default(now())

  @@index([formId, createdAt])
  @@map("form_submissions")
}

// ---------------------------------------------------------------------------
// Contact
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Rate limiting — fixed-window counters shared by every app instance
// ---------------------------------------------------------------------------

model RateLimitBucket {
  key     String   @id // e.g. "contact:ip:1.2.3.4", "otp:phone:0912..."
  count   Int
  resetAt DateTime

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

/// Group SMS sent by an ADMIN (owner's request, 2026-10-03): to all members,
/// a kind of member, or the people enrolled in one course.
model SmsBroadcast {
  id            String    @id @default(cuid())
  /// "members" | "individuals" | "legal" | "course"
  audience      String
  courseId      String?
  /// Who it went to, in words, as it was at sending time (history list).
  audienceLabel String
  text          String
  recipients    Int
  sent          Int       @default(0)
  failed        Int       @default(0)
  finishedAt    DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@map("sms_broadcasts")
}

/// SMS_PROVIDER="sandbox" (development and the plain-HTTP preview only): the
/// messages that would have gone out, shown in the admin panel instead of
/// reaching a phone. Only the newest few hundred are kept.
model SandboxSms {
  id        String   @id @default(cuid())
  phone     String
  text      String
  /// The sign-in code of an OTP message, shown large for testers.
  code      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("sandbox_sms")
}

// ---------------------------------------------------------------------------
// Notifications — SMS/email sent to applicants when staff change a status
// ---------------------------------------------------------------------------

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
}

/// One row per message attempt. The text is not stored (it is rebuilt from
/// the event), only who, which channel and whether the provider accepted it.
model Notification {
  id        String              @id @default(cuid())
  entity    String // "Enrollment" | "ConsultingRequest"
  entityId  String
  event     String // e.g. "status.ACCEPTED"
  channel   NotificationChannel
  recipient String
  status    NotificationStatus
  createdAt DateTime            @default(now())

  @@index([entity, entityId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Reminders (owner's request, 2026-10-04): an SMS before a booking or a course
// starts, sent by the scheduler through /api/cron/reminders (modules/reminders)
// ---------------------------------------------------------------------------

enum ReminderKind {
  BOOKING
  COURSE
}

/// One row per reminder, inserted (claimed) before the message is sent, so two
/// scheduler runs never remind the same start twice. A moved start time is a
/// new occurrence and gets its own reminder.
model Reminder {
  id           String       @id @default(cuid())
  kind         ReminderKind
  /// Booking id (BOOKING) or enrollment id (COURSE): a plain id, not a relation.
  targetId     String
  /// The start time this reminder was for.
  occurrenceAt DateTime
  /// Null while sending; false when there was no valid mobile or the provider refused.
  smsSent      Boolean?
  createdAt    DateTime     @default(now())

  @@unique([kind, targetId, occurrenceAt])
  @@index([createdAt])
  @@map("reminders")
}

/// Last run of each scheduled job (called by the scheduler), shown in the panel.
model JobRun {
  name      String   @id
  lastRunAt DateTime
  result    Json

  @@map("job_runs")
}

// ---------------------------------------------------------------------------
// Appointments (ADR-0003): staff profiles, bookable slots, member bookings
// ---------------------------------------------------------------------------

enum AppointmentService {
  CONSULTING // مرکز مشاوره
  SERVICE_DESK // میز خدمت
}

enum BookingStatus {
  BOOKED
  CANCELLED
  DONE
  NO_SHOW
}

model StaffProfile {
  id        String             @id @default(cuid())
  service   AppointmentService
  fullName  String
  title     String? // e.g. "مشاور بازاریابی"
  bio       String? // plain text, or Markdown for older profiles
  /// Introduction from the rich editor, sanitized (ADR-0005).
  bioHtml   String?
  /// Optional: receives an email for each new booking.
  email     String?
  /// Mobile number (09…): gets an SMS with the date and time of each new
  /// booking and of each cancellation by the member. Required in the form.
  mobile    String?
  /// Photo shown on the booking pages: storage key of the large WebP
  /// (`staff/<uuid>.webp`, see storeImage); a new upload gets a new key.
  photoKey  String?
  isActive  Boolean            @default(true)
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  slots AppointmentSlot[]

  @@index([service, isActive])
  @@map("staff_profiles")
}

model AppointmentSlot {
  id          String       @id @default(cuid())
  staffId     String
  staff       StaffProfile @relation(fields: [staffId], references: [id], onDelete: Restrict)
  startsAt    DateTime
  endsAt      DateTime
  /// Place or meeting note shown to the member, e.g. "دفتر مرکز" or "تلفنی".
  location    String?
  isCancelled Boolean      @default(false)
  createdAt   DateTime     @default(now())

  bookings Booking[]

  @@unique([staffId, startsAt])
  @@index([startsAt])
  @@map("appointment_slots")
}

model Booking {
  id           String          @id @default(cuid())
  slotId       String
  slot         AppointmentSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  /// Equals slotId while the booking is live (BOOKED/DONE/NO_SHOW), null once
  /// cancelled: the unique index makes a second live booking of a slot impossible.
  activeSlotId String?         @unique
  /// The member (members domain) — a plain id, not a cross-domain relation.
  memberId     String
  fullName     String
  phone        String
  email        String?
  nationalId   String?
  companyName  String?
  topic        String
  description  String?
  status       BookingStatus   @default(BOOKED)
  cancelledAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([memberId])
  @@index([slotId])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Statistics — anonymous daily page-view counts (no IP, cookie or visitor id)
// ---------------------------------------------------------------------------

model PageViewDaily {
  /// Calendar day in Tehran time.
  day   DateTime @db.Date
  path  String
  count Int      @default(0)

  @@id([day, path])
  @@index([day])
  @@map("page_views_daily")
}

// ---------------------------------------------------------------------------
// Error reporting — server errors grouped by fingerprint (see modules/errors)
// ---------------------------------------------------------------------------

model ErrorGroup {
  id          String    @id @default(cuid())
  /// Hash of the error name, its message with numbers/ids masked, and the route.
  fingerprint String    @unique
  name        String
  message     String
  stack       String?
  /// Route pattern such as /courses/[slug]; never a query string.
  route       String?
  /// "render" | "route" | "action" | "middleware"
  routeType   String?
  method      String?
  lastPath    String?
  digest      String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Set by an admin; a new occurrence clears it (the error is open again).
  resolvedAt  DateTime?

  @@index([resolvedAt, lastSeenAt])
  @@map("error_groups")
}
